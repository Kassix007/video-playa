# Browser-safe Supabase identity. Never put a secret/service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Read-only post-deploy smoke target. Used by verify:fantasy-prod, never sent to the browser bundle.
FANTASY_PRODUCTION_SITE_URL=https://your-site.example

# Server-only Supabase access for Netlify functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Shared server-to-server sync authorization. Use a long random value.
FANTASY_PEAKPOOL_SYNC_TOKEN=replace_with_random_server_only_value

# ATR is legacy and remains disabled. Enable PMU only after migrations and smoke validation.
FANTASY_ATR_RESULTS_ENABLED=false
FANTASY_PMU_RESULTS_ENABLED=false
FANTASY_RESULT_CRON_TOKEN=replace_with_random_server_only_value

# Optional Edge-to-Netlify sync endpoint configured after deployment.
FANTASY_PEAKPOOL_SYNC_URL=https://your-site.example/.netlify/functions/fantasy-peakpool-sync

# Separate HORSEE Peakpool virtual-unit MCP integration. This is unrelated to
# Fantasy Peakpool. Provider placement remains off until the documented,
# owner-authorized no-cash verification has been completed.
PEAKPOOL_ENABLED=false
PEAKPOOL_APP_BET_ENABLED=false
PEAKPOOL_APP_BET_VERIFIED=false
HORSEE_OAUTH_PEAKPOOL_PREPARE_SCOPE=horsee:peakpool:prepare
HORSEE_OAUTH_PEAKPOOL_PLACE_SCOPE=horsee:peakpool:place
