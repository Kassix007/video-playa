{
    "stickyFooter": {
        "enable": false
    },
    "biometricAuth": {
        "enable": false,
        "showOnLoad": false,
        "showOnLoadWithSecret": false,
        "whiteListDomains": []
    },
    "navigationLoader": {
        "animationBgColor": "#f5f5f5",
        "animationJsonUrl": null,
        "animationShape": "RECTANGLE",
        "animationSize": "MEDIUM",
        "loaderColor": "#0029FF",
        "bgColor": "#FFFFFF",
        "type": "CircularLoader"
    },
    "orientationType": "PORTRAIT",
    "regexInternalExternal": {
        "rules": [
            {
                "type": "EXTERNAL",
                "label": "Non-web links",
                "regex": "^(?!https?://).*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Facebook",
                "regex": "https?://([-\\w]+\\.)*facebook\\.com.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Twitter",
                "regex": "https?://([-\\w]+\\.)*twitter\\.com/.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Instagram",
                "regex": "https?://([-\\w]+\\.)*instagram\\.com/.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Google Maps",
                "regex": "https?://maps\\.google\\.com.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Google Maps Search",
                "regex": "https?://([-\\w]+\\.)*google\\.com/maps/search/.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "LinkedIn",
                "regex": "https?://([-\\w]+\\.)*linkedin\\.com/.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "EXTERNAL",
                "label": "Whatsapp",
                "regex": "https?://([-\\w]+\\.)*whatsapp\\.com/.*",
                "pageType": "CUSTOM"
            },
            {
                "type": "INTERNAL",
                "label": "All Other Links",
                "regex": ".*",
                "pageType": "ALL_PAGES"
            }
        ]
    },
    "noInternetData": {
        "bgColor": "#FFFFFF",
        "pages": [
            {
                "elements": [
                    {
                        "fileName": "no_internet.png",
                        "fileUrl": "https://firebasestorage.googleapis.com/v0/b/web-to-native-dev.appspot.com/o/user-uploads%2FJnEsGYO67yYziwPpChL8%2Fuser-upload%2Ficon_ANDROID1699509452490.png?alt=media&token=4b7b7bfc-b832-4e70-b13a-cbb9d3788a09",
                        "type": "image"
                    },
                    {
                        "fontSize": 32,
                        "type": "text",
                        "value": "Oops!",
                        "textColor": "#363942",
                        "fontWeight": 700
                    },
                    {
                        "fontSize": 14,
                        "type": "text",
                        "value": "Slow or No Internet Connection Please check your connection settings",
                        "textColor": "#363942",
                        "fontWeight": 400
                    }
                ],
                "topMarginPercent": 14
            }
        ],
        "actionButtons": [
            {
                "btnBgColor": "#363942",
                "borderColor": "#363942",
                "borderWidth": 4,
                "text": "Try Again",
                "roundedCornerPercent": 8,
                "textColor": "#ffffff"
            }
        ]
    },
    "iapScreenData": null,
    "cssValue": "",
    "enableCustomBackHandling": {
        "enable": false,
        "mapping": [
            {
                "link": "",
                "type": "all"
            }
        ],
        "regEx": ".*"
    },
    "offerCard": {
        "enabled": true
    },
    "oneSignalCtrEnable": false
}